# FinAlly environment configuration.
# Copy this file to `.env` and fill in the values you need.

# Required: OpenRouter API key used by the LLM chat assistant.
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave blank to use the built-in GBM simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: Set to "true" to return deterministic mock LLM responses.
# Useful for E2E tests, CI, and offline development.
LLM_MOCK=false
