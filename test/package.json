{
  "name": "finally-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Playwright test suite for the FinAlly trading workstation.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps chromium",
    "docker:up": "docker compose -f docker-compose.test.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.test.yml down -v",
    "docker:logs": "docker compose -f docker-compose.test.yml logs -f app"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
