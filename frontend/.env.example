# Frontend env vars (Vercel reads NEXT_PUBLIC_* and exposes them to the browser).

# Base URL of the FinAlly backend.
# - Leave blank for local single-container dev (the FastAPI app serves both UI and API on the same origin).
# - Set to the Render backend URL when deploying frontend to Vercel,
#   e.g. https://finally-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=
